let CA=0;  
let CB=0;  
let OP="";  
  
function makeCaptcha(){  
  
 CA=Math.floor(Math.random()*16)+4;  
 CB=Math.floor(Math.random()*14)+2;  
  
 OP=["+","-","×"][  
  Math.floor(Math.random()*3)  
 ];  
  
 if(OP==="-" && CB>CA){  
  [CA,CB]=[CB,CA]  
 }  
}  
  
function captchaAnswer(){  
  
 if(OP==="+")return CA+CB;  
 if(OP==="-")return CA-CB;  
 return CA*CB;  
}  
  
function openCaptcha(){  
  
