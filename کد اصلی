  return toast("❌ آیدی عددی معتبر نیست");  
  
 if(!/^[A-Za-z0-9_.@]{3,32}$/.test(usr))  
  return toast("❌ Username معتبر نیست");  
  
 if(nm.length<2)  
  return toast("❌ نام را وارد کن");  
  
 S.numericId=nid;  
 S.username=usr.replace(/^@/,"");  
 S.name=nm;  
  
