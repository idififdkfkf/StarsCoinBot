function selectPlan(el,name,price){  
  
 document.querySelectorAll(  
  "#servicePlans .mission"  
 ).forEach(x=>{  
  x.style.borderColor=  
   "rgba(0,234,255,.1)"  
 });  
  
 el.style.borderColor="#ffd83d";  
  
 window.selectedService={  
  name,  
  price  
 };  
  
 const box=document.getElementById("selectedPlan");  
  
 box.style.display="block";  
  
 box.innerHTML=`  
  <b>  
   انتخاب شد: ${esc(name)}  
  </b>  
  
  <span style="  
   float:left;  
   color:var(--gold)  
  ">  
   ${price} LIBER  
  </span>  
 `  
}  
  
function confirmService(type,icon){  
  
 if(!window.selectedService)  
  return toast("اول نوع سرویس را انتخاب کن");  
  
 const link=  
  document.getElementById("serviceLink")  
  .value.trim();  
  
 const description=  
  document.getElementById("serviceDescription")  
  .value.trim();  
  
 if(!link)  
  return toast("لینک سفارش را وارد کن");  
  
 if(!description)  
  return toast("توضیحات را وارد کن");  
  
 const price=  
  window.selectedService.price;  
  
 if(S.liber<price)  
  return toast("💰 موجودی LIBER کافی نیست");  
  
 const code=  
  "NX-"+Date.now().toString(36).toUpperCase();  
  
 const order={  
  id:code,  
  type,  
  icon,  
  plan:window.selectedService.name,  
  price,  
  link,  
  description,  
  numericId:S.numericId,  
  username:S.username,  
  name:S.name,  
  createdAt:Date.now(),  
  status:"در انتظار بررسی"  
 };  
  
 S.liber-=price;  
  
 S.orders.unshift(order);  
  
 save();  
  
 window.selectedService=null;  
  
 orderSuccess(order)  
}  
  
