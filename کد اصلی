<!DOCTYPE html>  <html lang="fa" dir="rtl">  
<head>  
<meta charset="UTF-8">  
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">  
<title>LIBER NEXUS X</title>  <style>  
*{  
 box-sizing:border-box;  
 margin:0;  
 padding:0;  
 -webkit-tap-highlight-color:transparent  
}  
  
:root{  
 --bg:#01040a;  
 --panel:rgba(5,15,29,.84);  
 --panel2:rgba(7,25,45,.78);  
 --blue:#00eaff;  
 --blue2:#0877ff;  
 --gold:#ffd83d;  
 --gold2:#ff9900;  
 --cyan:#65f7ff;  
 --green:#2dffae;  
 --red:#ff416c;  
 --white:#f5fbff;  
 --muted:#7990aa;  
}  
  
html,body{  
 min-height:100%;  
 background:#01040a;  
 color:var(--white);  
 font-family:Tahoma,Arial,sans-serif;  
 overflow-x:hidden  
}  
  
body{  
 background:  
 radial-gradient(circle at 50% -15%,rgba(0,234,255,.25),transparent 35%),  
 radial-gradient(circle at 100% 45%,rgba(255,216,61,.13),transparent 30%),  
 radial-gradient(circle at 0 80%,rgba(8,119,255,.16),transparent 32%),  
 #01040a;  
}  
  
body:before{  
 content:"";  
 position:fixed;  
 inset:0;  
 pointer-events:none;  
 opacity:.25;  
 background-image:  
 radial-gradient(circle,rgba(0,234,255,.8) 1px,transparent 1.6px),  
 radial-gradient(circle,rgba(255,216,61,.7) 1px,transparent 1.6px);  
 background-size:75px 75px,121px 121px;  
 background-position:10px 15px,50px 80px;  
 animation:stars 25s linear infinite  
}  
  
@keyframes stars{  
 to{  
  background-position:110px 120px,-10px -20px  
 }  
}  
  
button,input{  
 font-family:inherit  
}  
  
button{  
 border:0;  
 color:white;  
 cursor:pointer  
}  
  
button:active{  
 transform:scale(.94)  
}  
  
.app{  
 width:min(520px,100%);  
 min-height:100vh;  
 margin:auto;  
 position:relative;  
 padding-bottom:90px  
}  
  
.screen{  
 min-height:100vh;  
 padding:15px;  
 animation:screenIn .45s ease  
}  
  
@keyframes screenIn{  
 from{  
  opacity:0;  
  transform:translateY(18px) scale(.98)  
 }  
 to{  
  opacity:1;  
  transform:none  
 }  
}  
  
.hidden{  
 display:none!important  
}  
  
.center{  
 text-align:center  
}  
  
/* =========================  
   INTRO  
========================= */  
  
.intro{  
 min-height:100vh;  
 display:grid;  
 place-items:center;  
 position:relative  
}  
  
.introCore{  
 width:340px;  
 height:500px;  
 position:relative;  
 display:flex;  
 flex-direction:column;  
 align-items:center;  
 justify-content:center  
}  
  
.orbit{  
 position:absolute;  
 left:50%;  
 top:42%;  
 transform:translate(-50%,-50%);  
 border-radius:50%;  
 pointer-events:none  
}  
  
.o1{  
 width:170px;  
 height:170px;  
 border:1px solid rgba(0,234,255,.7);  
 animation:orbit 4s linear infinite  
}  
  
.o2{  
 width:250px;  
 height:250px;  
 border:1px solid rgba(255,216,61,.35);  
 animation:orbit 7s linear infinite reverse  
}  
  
.o3{  
 width:340px;  
 height:340px;  
 border:1px dashed rgba(0,234,255,.25);  
 animation:orbit 13s linear infinite  
}  
  
@keyframes orbit{  
 to{  
  transform:translate(-50%,-50%) rotate(360deg)  
 }  
}  
  
.core{  
 width:125px;  
 height:125px;  
 border-radius:50%;  
 display:grid;  
 place-items:center;  
 position:relative;  
 z-index:2;  
 font-size:62px;  
 font-weight:1000;  
 color:#051525;  
 background:  
 radial-gradient(circle at 27% 18%,  
 #fff 0,  
 #fff7ad 12%,  
 #ffe34b 34%,  
 #ffb800 57%,  
 #00eaff 61%,  
 #006cff 100%);  
 border:6px solid #fff2a0;  
 box-shadow:  
 0 0 30px rgba(255,216,61,.8),  
 0 0 80px rgba(0,234,255,.5),  
 inset 0 8px 14px white;  
 animation:coreFloat 2.3s ease-in-out infinite  
}  
  
@keyframes coreFloat{  
 50%{  
  transform:translateY(-12px) rotateY(20deg) scale(1.04)  
 }  
}  
  
.introTitle{  
 margin-top:45px;  
 font-size:45px;  
 letter-spacing:9px;  
 font-weight:1000;  
 background:linear-gradient(  
  90deg,  
  #fff,  
  #00eaff,  
  #fff,  
  #ffd83d,  
  #00eaff,  
  #fff  
 );  
 background-size:400%;  
 -webkit-background-clip:text;  
 color:transparent;  
 animation:rgbText 3s linear infinite  
}  
  
@keyframes rgbText{  
 to{  
  background-position:400%  
 }  
}  
  
.neonSub{  
 color:var(--muted);  
 font-size:9px;  
 letter-spacing:5px;  
 margin-top:8px  
}  
  
/* =========================  
   HEADER  
========================= */  
  
.header{  
 display:flex;  
 align-items:center;  
 justify-content:space-between;  
 margin-bottom:14px  
}  
  
.brand{  
 display:flex;  
 align-items:center;  
 gap:10px  
}  
  
.logoMini{  
 width:45px;  
 height:45px;  
 border-radius:15px;  
 display:grid;  
 place-items:center;  
 color:#071421;  
 font-size:23px;  
 font-weight:1000;  
 background:  
 linear-gradient(145deg,  
 #fff,  
 #ffe96b 35%,  
 #ffb900 58%,  
 #00eaff 60%,  
 #0075ff);  
 border:2px solid #fff4a0;  
 box-shadow:  
 0 0 20px rgba(0,234,255,.35),  
 0 0 20px rgba(255,216,61,.28)  
}  
  
.title{  
 font-size:16px;  
 font-weight:1000  
}  
  
.sub{  
 color:var(--muted);  
 font-size:8px;  
 margin-top:4px  
}  
  
/* =========================  
   CARDS  
========================= */  
  
.card{  
 position:relative;  
 overflow:hidden;  
 padding:15px;  
 margin-bottom:10px;  
 border-radius:25px;  
 border:1px solid rgba(0,234,255,.18);  
 background:  
 linear-gradient(145deg,  
 rgba(9,31,53,.9),  
 rgba(2,8,17,.94));  
 box-shadow:  
 0 20px 65px rgba(0,0,0,.48),  
 inset 0 0 35px rgba(0,234,255,.035)  
}  
  
.card:before{  
 content:"";  
 position:absolute;  
 width:200px;  
 height:200px;  
 right:-100px;  
 top:-110px;  
 border-radius:50%;  
 background:radial-gradient(  
  circle,  
  rgba(0,234,255,.17),  
  transparent 70%  
 );  
 pointer-events:none  
}  
  
.card:after{  
 content:"";  
 position:absolute;  
 inset:0;  
 pointer-events:none;  
 border-radius:25px;  
 background:linear-gradient(  
  115deg,  
  transparent 20%,  
  rgba(255,255,255,.025) 50%,  
  transparent 80%  
 );  
 animation:sheen 5s linear infinite  
}  
  
@keyframes sheen{  
 from{transform:translateX(-100%)}  
 to{transform:translateX(100%)}  
}  
  
/* =========================  
   BUTTON  
========================= */  
  
.btn{  
 width:100%;  
 padding:14px;  
 border-radius:18px;  
 font-weight:1000;  
 background:  
 linear-gradient(135deg,  
 #006cff,  
 #00eaff);  
 border:1px solid rgba(255,255,255,.15);  
 box-shadow:  
 0 10px 30px rgba(0,190,255,.22);  
 position:relative;  
 overflow:hidden  
}  
  
.btn:after{  
 content:"";  
 position:absolute;  
 width:70px;  
 height:100%;  
 top:0;  
 left:-100px;  
 background:linear-gradient(  
  90deg,  
  transparent,  
  rgba(255,255,255,.5),  
  transparent  
 );  
 transform:skewX(-20deg);  
 animation:buttonShine 3s infinite  
}  
  
@keyframes buttonShine{  
 0%,55%{left:-100px}  
 100%{left:120%}  
}  
  
.btn.gold{  
 color:#241800;  
 background:  
 linear-gradient(135deg,  
 #ff9900,  
 #ffd83d,  
 #fff0a0)  
}  
  
.btn.green{  
 color:#03170f;  
 background:  
 linear-gradient(135deg,  
 #069b68,  
 #2dffae)  
}  
  
.btn.red{  
 background:linear-gradient(135deg,#a8173e,#ff416c)  
}  
  
/* =========================  
   COIN  
========================= */  
  
.coin{  
 width:105px;  
 height:105px;  
 margin:auto;  
 border-radius:50%;  
 display:grid;  
 place-items:center;  
 position:relative;  
 font-size:43px;  
 font-weight:1000;  
 color:#071b31;  
 background:  
 radial-gradient(circle at 28% 18%,  
 #fff 0,  
 #fff8b0 12%,  
 #ffe34a 35%,  
 #ffc018 57%,  
 #00eaff 61%,  
 #006cff 100%);  
 border:6px solid #fff2a0;  
 box-shadow:  
 0 0 32px rgba(255,216,61,.75),  
 0 0 70px rgba(0,234,255,.42),  
 inset 0 8px 13px white,  
 inset 0 -17px 25px rgba(0,55,110,.5);  
 animation:coinFloat 2.2s ease-in-out infinite  
}  
  
@keyframes coinFloat{  
 50%{  
  transform:translateY(-7px) rotateY(18deg)  
 }  
}  
  
.coin:before,  
.coin:after{  
 content:"";  
 position:absolute;  
 border-radius:50%;  
 pointer-events:none  
}  
  
.coin:before{  
 inset:-14px;  
 border:2px solid rgba(0,234,255,.55);  
 animation:spin 4s linear infinite  
}  
  
.coin:after{  
 inset:-25px;  
 border:1px dashed rgba(255,216,61,.3);  
 animation:spin 8s linear infinite reverse  
}  
  
@keyframes spin{  
 to{  
  transform:rotate(360deg)  
 }  
}  
  
/* =========================  
   BALANCE  
========================= */  
  
.balance{  
 font-size:32px;  
 font-weight:1000;  
 margin-top:13px  
}  
  
.balance small{  
 color:var(--gold);  
 font-size:10px  
}  
  
/* =========================  
   MINER  
========================= */  
  
.minerWrap{  
 width:230px;  
 height:230px;  
 margin:18px auto;  
 display:grid;  
 place-items:center;  
 position:relative  
}  
  
.miner{  
 width:165px;  
 height:165px;  
 border-radius:50%;  
 position:relative;  
 z-index:2;  
 display:grid;  
 place-items:center;  
 font-size:65px;  
 font-weight:1000;  
 color:#061a31;  
 background:  
 radial-gradient(circle at 28% 17%,  
 #fff,  
 #fff6a0 12%,  
 #ffe14a 34%,  
 #ffbd00 57%,  
 #00eaff 61%,  
 #006cff 100%);  
 border:7px solid #fff1a0;  
 box-shadow:  
 0 0 38px rgba(255,216,61,.8),  
 0 0 90px rgba(0,234,255,.35),  
 inset 0 9px 15px white,  
 inset 0 -22px 28px rgba(0,50,100,.5);  
 transition:.1s  
}  
  
.minerRing{  
 position:absolute;  
 inset:8px;  
 border-radius:50%;  
 border:2px solid rgba(0,234,255,.7);  
 box-shadow:  
 0 0 25px rgba(0,234,255,.4);  
 animation:spin 4s linear infinite  
}  
  
.minerRing2{  
 position:absolute;  
 inset:-5px;  
 border-radius:50%;  
 border:1px dashed rgba(255,216,61,.6);  
 animation:spin 8s linear infinite reverse  
}  
  
.minerRing3{  
 position:absolute;  
 inset:-19px;  
 border-radius:50%;  
 border:1px solid rgba(0,234,255,.2);  
 animation:spin 12s linear infinite  
}  
  
.miner.hit{  
 animation:minerHit .22s ease  
}  
  
@keyframes minerHit{  
 0%{transform:scale(1)}  
 35%{transform:scale(.87) rotate(-3deg)}  
 70%{transform:scale(1.08) rotate(3deg)}  
 100%{transform:scale(1)}  
}  
  
/* =========================  
   STATS  
========================= */  
  
.stats{  
 display:grid;  
 grid-template-columns:repeat(3,1fr);  
 gap:7px;  
 margin-bottom:10px  
}  
  
.stat{  
 text-align:center;  
 padding:12px 3px;  
 border-radius:17px;  
 background:#041225;  
 border:1px solid rgba(0,234,255,.13)  
}  
  
.stat b{  
 display:block;  
 font-size:14px  
}  
  
.stat span{  
 color:var(--muted);  
 font-size:8px  
}  
  
/* =========================  
   MENU  
========================= */  
  
.menuGrid{  
 display:grid;  
 grid-template-columns:repeat(3,1fr);  
 gap:8px  
}  
  
.menu{  
 height:90px;  
 border-radius:20px;  
 position:relative;  
 overflow:hidden;  
 background:  
 linear-gradient(145deg,  
 #0b2c4a,  
 #030b17);  
 border:1px solid rgba(0,234,255,.17);  
 box-shadow:  
 inset 0 0 25px rgba(0,234,255,.035),  
 0 8px 25px rgba(0,0,0,.2);  
 transition:.2s  
}  
  
.menu:hover{  
 transform:translateY(-3px);  
 border-color:rgba(255,216,61,.45)  
}  
  
.menu span{  
 display:block;  
 font-size:29px;  
 margin-bottom:7px;  
 filter:drop-shadow(0 0 8px rgba(0,234,255,.45));  
 animation:emojiFloat 2.5s ease-in-out infinite  
}  
  
.menu b{  
 font-size:9px  
}  
  
@keyframes emojiFloat{  
 50%{  
  transform:translateY(-3px) rotate(4deg)  
 }  
}  
  
/* =========================  
   INPUT  
========================= */  
  
label{  
 display:block;  
 color:var(--muted);  
 font-size:9px;  
 margin:11px 0 5px  
}  
  
input{  
 width:100%;  
 padding:14px;  
 border-radius:16px;  
 color:white;  
 background:#020914;  
 border:1px solid #174360;  
 outline:none  
}  
  
input:focus{  
 border-color:var(--blue);  
 box-shadow:0 0 22px rgba(0,234,255,.15)  
}  
  
/* =========================  
   PROFILE  
========================= */  
  
.profileAvatar{  
 width:105px;  
 height:105px;  
 border-radius:50%;  
 object-fit:cover;  
 border:3px solid var(--blue);  
 box-shadow:  
 0 0 30px rgba(0,234,255,.45);  
 position:relative  
}  
  
.profileFrame{  
 padding:7px;  
 display:inline-block;  
 border-radius:50%;  
 background:  
 conic-gradient(  
  #00eaff,  
  #0877ff,  
  #ffd83d,  
  #ff9900,  
  #00eaff  
 );  
 animation:frameSpin 4s linear infinite  
}  
  
@keyframes frameSpin{  
 to{  
  filter:hue-rotate(360deg)  
 }  
}  
  
.profileName{  
 font-size:22px;  
 font-weight:1000;  
 margin-top:12px;  
 animation:nameRGB 3s linear infinite  
}  
  
@keyframes nameRGB{  
 0%{color:#00eaff}  
 33%{color:#ffd83d}  
 66%{color:#fff}  
 100%{color:#00eaff}  
}  
  
.profileEmoji{  
 display:inline-block;  
 font-size:28px;  
 vertical-align:middle;  
 animation:emoji3d 1.7s ease-in-out infinite  
}  
  
@keyframes emoji3d{  
 0%,100%{  
  transform:translateY(0) rotateY(0) scale(1)  
 }  
 50%{  
  transform:translateY(-6px) rotateY(25deg) scale(1.12)  
 }  
}  
  
/* =========================  
   PREMIUM  
========================= */  
  
.premium{  
 border:1px solid rgba(255,216,61,.35);  
 background:  
 linear-gradient(  
  145deg,  
  rgba(255,180,0,.13),  
  rgba(0,234,255,.08),  
  rgba(3,10,20,.9)  
 )  
}  
  
.premiumIcon{  
 font-size:58px;  
 animation:premiumFloat 2s ease-in-out infinite  
}  
  
@keyframes premiumFloat{  
 50%{  
  transform:translateY(-8px) rotate(8deg) scale(1.08)  
 }  
}  
  
/* =========================  
   SERVICE  
========================= */  
  
.serviceGrid{  
 display:grid;  
 grid-template-columns:repeat(2,1fr);  
 gap:9px  
}  
  
.service{  
 min-height:115px;  
 padding:15px;  
 border-radius:20px;  
 background:  
 linear-gradient(145deg,#082642,#030c18);  
 border:1px solid rgba(0,234,255,.16);  
 transition:.2s  
}  
  
.service:hover{  
 transform:translateY(-3px)  
}  
  
.serviceIcon{  
 font-size:35px;  
 margin-bottom:7px  
}  
  
.service b{  
 font-size:11px  
}  
  
.service small{  
 display:block;  
 color:var(--muted);  
 font-size:8px;  
 margin-top:5px;  
 line-height:1.8  
}  
  
/* =========================  
   ORDER  
========================= */  
  
.order{  
 padding:13px;  
 border-radius:18px;  
 background:#041426;  
 border:1px solid rgba(0,234,255,.13);  
 margin-top:8px  
}  
  
.order.pending{  
 border-color:rgba(255,216,61,.3)  
}  
  
.order.done{  
 border-color:rgba(45,255,174,.3)  
}  
  
/* =========================  
   MISSION  
========================= */  
  
.mission{  
 padding:13px;  
 border-radius:17px;  
 background:#041426;  
 border:1px solid rgba(0,234,255,.1);  
 margin-top:8px  
}  
  
.mission.done{  
 border-color:#20c887;  
 background:#06271d  
}  
  
/* =========================  
   PROGRESS  
========================= */  
  
.progress{  
 height:8px;  
 border-radius:20px;  
 overflow:hidden;  
 background:#020812  
}  
  
.progress i{  
 display:block;  
 height:100%;  
 width:0;  
 background:  
 linear-gradient(  
  90deg,  
  #006cff,  
  #00eaff,  
  #ffd83d,  
  #ff9900  
 );  
 box-shadow:0 0 18px #00eaff;  
 transition:.4s  
}  
  
/* =========================  
   TOAST  
========================= */  
  
.toast{  
 position:fixed;  
 z-index:999;  
 top:12px;  
 left:50%;  
 transform:translate(-50%,-25px);  
 opacity:0;  
 padding:12px 17px;  
 border-radius:16px;  
 background:#09223a;  
 border:1px solid #1678a3;  
 font-size:10px;  
 transition:.25s;  
 white-space:nowrap;  
 box-shadow:0 10px 30px rgba(0,0,0,.5)  
}  
  
.toast.show{  
 opacity:1;  
 transform:translate(-50%,0)  
}  
  
/* =========================  
   FX  
========================= */  
  
.plus{  
 position:fixed;  
 z-index:1000;  
 color:#ffe45d;  
 font-size:20px;  
 font-weight:1000;  
 text-shadow:0 0 17px #00eaff;  
 pointer-events:none;  
 animation:plusFly .75s ease-out forwards  
}  
  
@keyframes plusFly{  
 to{  
  transform:translateY(-75px) scale(1.25);  
  opacity:0  
 }  
}  
  
.spark{  
 position:fixed;  
 z-index:999;  
 width:5px;  
 height:5px;  
 border-radius:50%;  
 background:#00eaff;  
 box-shadow:0 0 14px #00eaff;  
 pointer-events:none;  
 animation:sparkFly .65s ease-out forwards  
}  
  
@keyframes sparkFly{  
 to{  
  transform:translate(var(--x),var(--y)) scale(0);  
  opacity:0  
 }  
}  
  
.flash{  
 position:fixed;  
 z-index:998;  
 inset:0;  
 pointer-events:none;  
 background:  
 radial-gradient(  
  circle,  
  rgba(255,230,70,.35),  
  rgba(0,234,255,.1),  
  transparent 65%  
 );  
 animation:flash .2s forwards  
}  
  
@keyframes flash{  
 0%{opacity:0}  
 30%{opacity:1}  
 100%{opacity:0}  
}  
  
/* =========================  
   NAV  
========================= */  
  
.nav{  
 position:fixed;  
 z-index:500;  
 bottom:7px;  
 left:50%;  
 transform:translateX(-50%);  
 width:min(490px,calc(100% - 14px));  
 height:63px;  
 display:grid;  
 grid-template-columns:repeat(5,1fr);  
 border-radius:23px;  
 background:rgba(2,11,23,.94);  
 border:1px solid rgba(0,234,255,.18);  
 box-shadow:0 15px 55px rgba(0,0,0,.65);  
 backdrop-filter:blur(20px)  
}  
  
.nav button{  
 background:none;  
 color:#607890;  
 font-size:7px  
}  
  
.nav b{  
 display:block;  
 font-size:19px;  
 margin-bottom:2px  
}  
  
.nav .active{  
 color:#00eaff;  
 text-shadow:0 0 14px #00eaff  
}  
  
/* =========================  
   SWITCH  
========================= */  
  
.switch{  
 display:flex;  
 align-items:center;  
 justify-content:space-between;  
 padding:13px;  
 border-radius:17px;  
 background:#041426;  
 margin-top:8px  
}  
  
.toggle{  
 width:54px;  
 height:29px;  
 border-radius:30px;  
 background:#16283a;  
 padding:3px;  
 transition:.3s  
}  
  
.toggle i{  
 display:block;  
 width:23px;  
 height:23px;  
 border-radius:50%;  
 background:#607890;  
 transition:.3s  
}  
  
.toggle.on{  
 background:#006cff  
}  
  
.toggle.on i{  
 transform:translateX(-23px);  
 background:#00eaff;  
 box-shadow:0 0 13px #00eaff  
}  
  
/* =========================  
   COLOR PICKER  
========================= */  
  
.colorRow{  
 display:grid;  
 grid-template-columns:repeat(6,1fr);  
 gap:7px;  
 margin-top:10px  
}  
  
.color{  
 height:35px;  
 border-radius:12px;  
 border:2px solid rgba(255,255,255,.1)  
}  
  
.c1{background:#00eaff}  
.c2{background:#0877ff}  
.c3{background:#ffd83d}  
.c4{background:#ff416c}  
